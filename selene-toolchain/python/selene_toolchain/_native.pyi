"""Private ABI implemented by the Rust extension; use the public Python API."""

from pathlib import Path

def _shutdown() -> None: ...

class LinkError(RuntimeError):
    entries: list[LinkDiagnostic]
    diagnostics: str
    raw_diagnostics: str
    inputs: list[str]

class LinkReference:
    @property
    def relation(self) -> str: ...
    @property
    def source(self) -> str | None: ...
    @property
    def line(self) -> int | None: ...
    @property
    def column(self) -> int | None: ...
    @property
    def artifact(self) -> str | None: ...
    @property
    def function(self) -> str | None: ...
    @property
    def context(self) -> str | None: ...

class LinkDiagnostic:
    @property
    def severity(self) -> str: ...
    @property
    def kind(self) -> str: ...
    @property
    def message(self) -> str: ...
    @property
    def symbol(self) -> str | None: ...
    @property
    def references(self) -> list[LinkReference]: ...
    @property
    def details(self) -> list[str]: ...

class Artifact:
    @staticmethod
    def from_bytes(kind_name: str, bytes: bytes, *, name: str | None = ...) -> Artifact: ...
    @staticmethod
    def from_path(kind_name: str, path: Path) -> Artifact: ...
    @property
    def name(self) -> str: ...
    @property
    def digest(self) -> str: ...
    @property
    def kind(self) -> str: ...
    def copy_to(self, path: Path) -> None: ...
    def bytes(self) -> list[int]: ...

class Plan:
    def describe(self) -> str: ...

class Toolchain:
    def __init__(self, root: Path) -> None: ...
    def version(self) -> str: ...
    def inspect(self, artifact: Artifact) -> str: ...
    def compile_plan(
        self, source: Artifact, optimisation: int, retarget: bool
    ) -> Plan: ...
    def link_plan(
        self,
        inputs: list[Artifact | Plan],
        system: list[str],
        search: list[Path],
        flags: list[str],
        shared: bool,
    ) -> Plan: ...
    def compile_bytes(self, data: bytes, target: str) -> list[int]: ...

class Store:
    def __init__(self, root: Path | None = ...) -> None: ...
    @property
    def root(self) -> Path: ...
    def build(self, plan: Plan) -> BuildResult: ...
    def clean(self, dry_run: bool = ...) -> int: ...

class Executor:
    def __init__(self, store: Store, *, jobs: int = ...) -> None: ...
    @property
    def jobs(self) -> int: ...
    def build(self, plan: Plan) -> BuildResult: ...

class BuildResult:
    @property
    def artifact(self) -> Artifact: ...
    @property
    def path(self) -> Path: ...
    @property
    def cache_hit(self) -> bool: ...
    @property
    def diagnostics(self) -> str: ...
    @property
    def key(self) -> str: ...
